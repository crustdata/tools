# Your Crustdata API key (https://app.crustdata.com). The CLI needs it. On the web it is the deployment's key: the
# page runs on it unless a visitor pastes their own.
CRUSTDATA_API_KEY=

# Optional, web: hide credit numbers from visitors who have not pasted a key (for a copy exposed to strangers).
# The estimate line and the cost bar then show rows and companies only. Default: shown.
SHOW_CREDITS=true

# Optional, web: the most rows one run may enrich. Bigger files are cut to this and pointed to the CLI. Default 500.
MAX_ROWS_PER_RUN=500

# Optional: stop a run before its next call once it has spent this many credits. Off by default. People and companies
# run side by side, so a run can pass the cap by one batch of each (at most 25 people and 25 companies).
MAX_CREDITS_PER_RUN=

# Optional, web: credits the deployment's key may spend per UTC day across all visitors (per server instance). Off by default.
DAILY_CREDIT_CAP=

# Optional, web: hours the server keeps fetched records in memory, per key; shared by everyone on the deployment key.
# 0 turns it off. Default 24.
CACHE_TTL_HOURS=

# Optional, web: let visitors use the deployment's key at all. Set false to require a pasted key. Default true.
ALLOW_SERVER_KEY=true

# Optional, CLI: where the cache lives. Default data/cache.sqlite.
CACHE_PATH=

# Optional, web: serve under a sub path, for example /tools/clay-alternative
BASE_PATH=

# Optional, web: the public URL of this deployment, for link previews
SITE_URL=
