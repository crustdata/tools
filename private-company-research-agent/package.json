    "web traffic",
    "funding history",
    "employee departures",
    "red flags",
    "pitchbook alternative",
    "harmonic alternative",
    "crunchbase alternative",
    "crustdata",
    "crustdata api",
    "company data api",
    "open source",
    "open source due diligence",
    "due diligence memo",
    "startup due diligence",
    "employee departures api",
    "vc tools",
    "ai agent",
    "typescript"
  ],
  "author": "Crustdata",
  "homepage": "https://github.com/crustdata/tools/tree/main/private-company-research-agent#readme",
