# Private company research agent settings. `npm run setup` fills these in for you.

# Your Crustdata API key, from https://app.crustdata.com (new accounts get free credits).
CRUSTDATA_API_KEY=

# Former staff read per company, at 0.23 credits each (list price). 0 skips the departures section.
LEAVERS_LIMIT=25

# Peers compared per company, at 0.63 credits each (list price). 0 skips peers (same as --no-peers).
PEERS_LIMIT=5

# A run whose estimate (at list price) is above this many credits needs --yes. 0 turns the check off.
MAX_CREDITS_PER_RUN=150

# Days a saved answer is reused before it is fetched (and paid for) again. 0 turns the cache off.
CACHE_DAYS=7

# "all": memos name every former employee found. "leaders": only founders, executives and leaders are named;
# other former staff appear by role and month.
PEOPLE_DETAIL=all

# Where memos are written: out/<domain>/memo.md and memo.json; a list adds out/<list>/comparison.md and .csv.
OUT_DIR=out

# Optional, only for --ai (a short analyst note per memo, billed by your AI provider). Leave empty for none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Pin a model; by default the newest general model your key can use is picked.
ANTHROPIC_MODEL=
OPENAI_MODEL=
