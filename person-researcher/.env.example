# Person Researcher settings. `npm run setup` fills these in for you.

# Your Crustdata API key, from https://app.crustdata.com (new accounts get free credits).
CRUSTDATA_API_KEY=

# Your own company's email domains, comma-separated: attendees there are skipped and cost nothing.
SKIP_DOMAINS=

# A run whose estimate (at list price) is above this many credits needs --yes. 0 turns the check off.
MAX_CREDITS_PER_RUN=150

# Where briefs are written: out/<name>.md and out/<name>.json, plus out/index.md for several people.
OUT_DIR=out

# Hours a saved answer is reused before it is fetched (and paid for) again. 0 turns the cache off.
# Older saved answers are deleted at the start of each run.
CACHE_HOURS=24
