# Candidate Sourcing Agent settings. `npm run setup` fills these in for you.

# Your Crustdata API key, from https://app.crustdata.com (needed by npm run source and npm run contacts).
CRUSTDATA_API_KEY=

# Where each role's files go: out/<role name>/candidates.csv, shortlist.md, seen.csv, role.json, profiles.json.
OUT_DIR=out

# The one line at the end of each run about keeping the search going with a Crustdata watcher. false turns it off.
WATCH_HINT=true

# Optional, used only with --ai: one "why this candidate" sentence per shortlisted person. Scoring never uses AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Or OpenAI instead (both the key and the model id are needed).
OPENAI_API_KEY=
OPENAI_MODEL=
