# Candidate Verification Agent settings. `npm run setup` fills these in for you.

# Your Crustdata API key, from https://app.crustdata.com (needed by npm run verify).
CRUSTDATA_API_KEY=

# Optional: a Slack incoming webhook. When set, every run posts a summary with the candidates to review first or clarify in the screen.
# Use a private channel: the summary names candidates. --no-slack skips it for one run.
SLACK_WEBHOOK_URL=

# Optional, used only with --ai: a Claude-written summary per candidate and an overview. Verdicts never use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Where each list's files go: out/<list name>/verified.csv, report.md, unresolved.csv, results.json.
OUT_DIR=out

# A verdict younger than this many days is reused for free when the same person is on another list. 0 = never.
REUSE_VERDICTS_DAYS=30

# A run that may spend more than this many credits asks first (and needs --yes without a terminal).
CONFIRM_ABOVE_CREDITS=50

# A run that may spend more than this stops, even with --yes. Set it for scheduled runs. Empty = no limit.
MAX_CREDITS_PER_RUN=

# What the Slack summary shows: names (candidates to review, with reasons) or counts (numbers only).
SLACK_DETAIL=names
