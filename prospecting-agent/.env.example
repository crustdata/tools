# Required. This is all `npm run find` needs. Get a key at https://app.crustdata.com
CRUSTDATA_API_KEY=

# Optional: where `npm run find` writes accounts.csv, people.csv and icp.json (one folder per client)
OUT_DIR=./out

# Optional: Claude reads the ICP sentence and fills the filters (shown for confirmation before any search runs)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
