# Copy to .env (or run `npm run setup`, which writes this file for you).

# Required. Your Crustdata API key: https://app.crustdata.com (Settings > API keys).
CRUSTDATA_API_KEY=

# The competitors you track, their pages and your cities. Written by `npm run setup`, safe to edit by hand.
COMPETITORS_FILE=./competitors.json

# Where the digest goes. Leave both empty to get a markdown file and console output only.
# Slack incoming webhook (one channel): https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Email through Resend (https://resend.com). All three or none. DIGEST_EMAIL_TO takes a comma-separated list.
RESEND_API_KEY=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=

# Pages fetched per competitor each week (1 credit each). Pages beyond this number in competitors.json are skipped.
PAGES_PER_COMPETITOR=6
# Weekly caps on what the job and post watchers deliver, spread over their daily runs; anything over a cap arrives
# (and is billed) on a later run.
MAX_POSTS_PER_WEEK=200
MAX_JOBS_PER_WEEK=500

# Where state and digests live.
DB_PATH=./data/tracker.sqlite
DIGEST_DIR=./digests

# Show the names of competitors' staff next to their posts in the digest (titles only by default).
SHOW_POSTER_NAMES=false
