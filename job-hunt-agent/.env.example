# Job hunt agent settings. `npm run setup` fills these in for you; your search itself is in profile.json.

# Your Crustdata API key, from https://app.crustdata.com (new accounts get free credits).
CRUSTDATA_API_KEY=

# A run whose worst case (at your account's prices, read for free from GET /account/endpoints) is above this
# many credits needs --yes. 0 turns the check off.
MAX_CREDITS_PER_RUN=30

# Days a company's trend and the people found there are reused before they are paid for again. 0 turns it off.
CACHE_DAYS=14

# Port of the local dashboard (npm run dashboard). It listens on 127.0.0.1 only.
DASHBOARD_PORT=3480

# Where runs are written (out/<date>-<search>/) and where the local database lives.
OUT_DIR=out
DB_PATH=data/job-hunt.db

# Your search, written by npm run setup. Plain JSON you can edit.
PROFILE_PATH=profile.json
