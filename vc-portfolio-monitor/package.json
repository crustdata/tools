{
  "name": "vc-portfolio-monitor",
  "version": "1.0.0",
  "description": "Open-source VC portfolio monitoring agent on the Crustdata API: Slack alerts when a portfolio company's headcount drops, a founder or executive leaves, hiring stops or jumps, or a round closes, plus a weekly digest. CSV or Google Sheet in, no LLM, no server. Self-hosted alternative to Harmonic, Affinity and Visible for portfolio monitoring.",
  "keywords": [
    "portfolio-monitoring",
    "venture-capital",
    "vc-tools",
    "investor-tools",
    "portfolio-management",
    "startup-monitoring",
    "portfolio-alerts",
    "headcount",
    "layoff-alerts",
    "founder-departure",
    "executive-departure",
    "founder-tracking",
    "hiring-signals",
    "funding-alerts",
    "slack-alerts",
    "weekly-digest",
    "google-sheets",
    "harmonic-alternative",
    "affinity-alternative",
    "visible-alternative",
    "crustdata",
    "crustdata-api",
    "open-source",
    "ai-agent",
    "portfolio-tracker",
    "hiring-tracker"
  ],
  "homepage": "https://github.com/crustdata/tools/tree/main/vc-portfolio-monitor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/crustdata/tools.git",
    "directory": "vc-portfolio-monitor"
  },
  "bugs": {
    "url": "https://github.com/crustdata/tools/issues"
  },
  "author": "Crustdata",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "import": "tsx src/cli.ts import",
    "check": "tsx src/cli.ts check",
    "digest": "tsx src/cli.ts digest",
    "status": "tsx src/cli.ts status",
    "resend": "tsx src/cli.ts resend",
    "refresh-leaders": "tsx src/cli.ts refresh-leaders",
    "pause": "tsx src/cli.ts pause",
    "resume": "tsx src/cli.ts resume",
    "delete-watches": "tsx src/cli.ts delete-watches",
    "test-slack": "tsx src/cli.ts test-slack",
    "replay": "tsx src/replay.ts",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "resend": "^4.5.0",
    "tsx": "^4.19.0"
  },
