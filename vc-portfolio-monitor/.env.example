# Copy to .env (or run `npm run setup`, which writes this file for you).

# Required. Your Crustdata API key: https://app.crustdata.com (Settings > API keys).
CRUSTDATA_API_KEY=

# Your fund's name, used in message titles (default: Portfolio).
FUND_NAME=

# The portfolio: a CSV file in this folder, or a Google Sheet link (File > Share > Publish to web, as CSV).
# Columns: company, website, and optionally owner, status, careers, leaders. See portfolio.example.csv.
PORTFOLIO=./portfolio.csv

# Slack incoming webhook for alerts and the weekly digest. See "Send portfolio alerts to Slack" in the README.
SLACK_WEBHOOK_URL=
# Optional: each owner's alerts to their own channel. JSON, keys as the owner column spells them.
# SLACK_ROUTES={"Priya Shah": "https://hooks.slack.com/services/...", "Sam Lee": "https://hooks.slack.com/services/..."}
SLACK_ROUTES=

# Weekly digest by email through Resend (https://resend.com). All three or none. DIGEST_EMAIL_TO takes a comma-separated list.
RESEND_API_KEY=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=

# How fresh leader profiles are kept: 30, 14, 7, 3 or 1 days (5, 10, 20, 50 or 150 credits per leader whose profile
# changed; other values from 1 to 30 bill at the next fresher tier).
LEADER_REFRESH_DAYS=30
# Founders and C-level watched per company, 1 to 25.
MAX_LEADERS_PER_COMPANY=8
# Days between careers page readings, 3 to 28 (1 credit per company per reading).
HIRING_CHECK_DAYS=7
# Most credits an unattended import (npm run import -- --yes) may spend; above it, a person must run it.
MAX_IMPORT_CREDITS=500

# Where state, digests and thresholds live.
DB_PATH=./data/monitor.sqlite
DIGEST_DIR=./digests
THRESHOLDS_FILE=./config/thresholds.json

# Docker image only: 1 sends the digest on every run, 0 never; unset sends it on Mondays (UTC).
# RUN_DIGEST=
