    "crustdata",
    "nextjs",
    "cli",
    "open-source",
    "prospecting",
    "sales-research",
    "account-based-marketing",
    "exa-alternative",
    "lead-research"
  ],
  "homepage": "https://github.com/crustdata/tools/tree/main/company-researcher#readme",
  "repository": {
