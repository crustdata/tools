# Your Crustdata key (https://crustdata.com). The CLI needs it. On the web it is the demo key for visitors who do not
# paste their own key into the page.
CRUSTDATA_API_KEY=

# Optional: what visitors may use the server's key for. In production the demo covers vercel.com, clay.com and
# retool.com unless you list your own domains or open it to any company. Visitors who paste their own key are not
# limited by any of this.
DEMO_DOMAINS=
ALLOW_OPEN_DEMO=false
ALLOW_SERVER_KEY=true

# Optional: limits on the demo key. Credits per UTC day, and researches per visitor IP per 10 minutes.
DAILY_CREDIT_CAP=300
DEMO_RATE_LIMIT=30

# Optional: skip the tech stack (+2) and recent posts (+5) add-ons, 2.45 credits per research instead of 9.45
RESEARCH_LITE=false

# Optional: how long a company stays cached in memory
CACHE_TTL_HOURS=24

# Optional: serve the app under a sub path, for example /tools/company-researcher
BASE_PATH=

# Optional: print credits per call to stderr
LOG_CREDITS=false

# Optional, CLI only: an AI key makes the model write the brief. The web app only uses AI keys visitors bring.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: the public URL of this deployment, for link previews
SITE_URL=
