# Required for npm run source. Get a key at https://app.crustdata.com (npm run setup writes this file for you and checks the key).
CRUSTDATA_API_KEY=

# Optional: where the pipeline, memos and saved data go. One folder per thesis when you run several (or pass --out).
OUT_DIR=./out

# Optional: false leaves out the closing line that points at Crustdata watchers (same as --no-watch-hint).
WATCH_HINT=true

# Optional, off by default: an AI analysis in each memo, only when you pass --ai. Either key works; Anthropic is used when both are set.
# The instructions the model gets are in prompts/memo-analysis.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: pin a model. Empty means the newest general model your key can use, read from the provider's model list.
ANTHROPIC_MODEL=
OPENAI_MODEL=
