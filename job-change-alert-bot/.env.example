# Job Change Alert Bot settings. `npm run setup` fills in this file for you.

# ---- Required ----------------------------------------------------------------

# Crustdata API key: https://app.crustdata.com
CRUSTDATA_API_KEY=

# Public https base URL of this server. Crustdata delivers to PUBLIC_URL/webhooks/crustdata.
# To try it on a laptop, use a tunnel URL (npx cloudflared tunnel --url http://localhost:3000).
PUBLIC_URL=

# ---- Slack -------------------------------------------------------------------

# Slack incoming webhook for alerts and the digest: https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks/
# Leave empty to print alerts in the terminal instead.
SLACK_WEBHOOK_URL=

# Optional: send each owner's alerts to their own channel. JSON, keys are the owner column of your CSV
# (case and spaces ignored). The digest still goes to SLACK_WEBHOOK_URL.
# SLACK_ROUTES={"Sam Lee": "https://hooks.slack.com/services/..."}
SLACK_ROUTES=

# Optional: @mention the owner in alerts. JSON, values are Slack member IDs (profile, three dots, Copy member ID).
# OWNER_SLACK_IDS={"Sam Lee": "U012ABCDEF"}
OWNER_SLACK_IDS=

# ---- What to alert on --------------------------------------------------------

# Comma separated, any of: new_company, title_change, left_company, added_role
# (added_role is a side role such as advisor or board seat while the person stays at their company)
ALERT_KINDS=new_company,title_change,left_company

# realtime = one Slack message per change, digest = one message a day, both = both
ALERT_MODE=both

# ---- Watch settings (applied to the watch on every npm run import) -----------

# Data freshness in days, 1 to 30. Fresher data catches moves sooner and costs more per changed person:
# 30 = 5 credits, 14 = 10, 7 = 20, 3 = 50, 1 = 150. A value between tiers is billed at the fresher tier.
REFRESH_FREQUENCY_DAYS=30
# How often the watch reports, in hours.
CHECK_EVERY_HOURS=24
# Watch email matches only at or above this confidence (0 to 1). 1 = exact email matches only; 0 accepts every match.
# Applied on every import, including to matches already made.
MIN_MATCH_CONFIDENCE=0

# ---- Daily digest ------------------------------------------------------------

DIGEST_HOUR_UTC=8
# Email copy of the digest through Resend (https://resend.com). All three, or none.
RESEND_API_KEY=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=

# ---- Server ------------------------------------------------------------------

PORT=3000
DB_PATH=./data/bot.sqlite
# Accept webhooks without a valid signature. Local experiments only.
ALLOW_UNSIGNED_WEBHOOKS=false
