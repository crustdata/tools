# AI Researcher Finder settings. `npm run setup` fills these in for you.

# Your Crustdata API key, from https://app.crustdata.com (needed by npm run find and npm run map).
CRUSTDATA_API_KEY=

# Where each search's files go: out/<name>/researchers.csv, report.md, people.json, run.json.
OUT_DIR=out

# A run that can cost more than this many credits stops before it starts (raise it per run with --max-credits).
MAX_CREDITS=100

# Optional, used only with --ai: Claude answers the free-text "ask" lines in rubric.json from each person's record.
# Their name and links are never sent. Scoring works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
